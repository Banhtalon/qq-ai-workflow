{
  "schema_version": "qq.workflow.risk-rules.v9",
  "default_risk": "GREEN",
  "level_controls": {
    "GREEN": { "required_roles": [] },
    "YELLOW": { "required_roles": ["QUALIFIED_REVIEWER"] },
    "RED": { "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"] }
  },
  "rules": [
    {
      "id": "development-control-plane",
      "risk": "YELLOW",
      "path_globs": [".ai-workflow/**", ".agents/**", ".github/ISSUE_TEMPLATE/**", ".github/PULL_REQUEST_TEMPLATE.md", "AGENTS.md", "GEMINI.md", "eslint.config.js", "scripts/**", "test/**", "tests/**", "package*.json", "docs/*WORKFLOW*", "docs/*STATE*", "docs/*GUIDE*", "docs/workflow/**"],
      "required_roles": ["QUALIFIED_REVIEWER"],
      "reason": "Development policy, evidence, or gate control changed"
    },
    {
      "id": "source-code",
      "risk": "YELLOW",
      "path_globs": ["src/**", "apps/**", "lib/**"],
      "required_roles": ["QUALIFIED_REVIEWER"],
      "reason": "Runtime behavior changed"
    },
    {
      "id": "ci-or-deployment-control",
      "risk": "YELLOW",
      "path_globs": [".github/workflows/**", "infra/**", "Dockerfile", "docker-compose*.yml"],
      "required_roles": ["QUALIFIED_REVIEWER"],
      "reason": "Execution or deployment control changed"
    },
    {
      "id": "authentication-or-permission",
      "risk": "RED",
      "path_globs": ["**/auth/**", "**/permissions/**", "**/middleware.*", "**/*rls*", "**/*policy*.sql"],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Authentication, authorization, or permission boundary changed"
    },
    {
      "id": "database-migration",
      "risk": "RED",
      "path_globs": ["**/migrations/**", "supabase/**", "database/**", "**/schema.sql"],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Schema or persisted data may change"
    },
    {
      "id": "secret-material",
      "risk": "RED",
      "path_globs": [".env", ".env.*", "**/.env", "**/.env.*", "**/*secret*", "**/*credential*", "**/*private-key*"],
      "required_roles": ["TECHNICAL_OPERATOR"],
      "reason": "Secret-bearing path detected"
    },
    {
      "id": "destructive-or-privileged-diff",
      "risk": "RED",
      "diff_patterns": [
        "\\bDROP\\s+(TABLE|SCHEMA|DATABASE)\\b",
        "\\bTRUNCATE\\b",
        "\\bDELETE\\s+FROM\\b",
        "service[_-]?role",
        "force[_-]?push",
        "production[_-]?write"
      ],
      "required_roles": ["QUALIFIED_REVIEWER", "TECHNICAL_OPERATOR"],
      "reason": "Destructive or privileged operation detected in diff"
    }
  ]
}
