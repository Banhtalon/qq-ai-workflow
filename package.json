{
  "name": "qq-ai-workflow",
  "version": "10.1.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/workflow.test.mjs test/bridge.test.mjs test/fast-lane.test.mjs test/documentation.test.mjs test/gemini-first.test.mjs test/receipts.test.mjs test/controlled-bridge.test.mjs test/execution-policy.test.mjs test/execution-receipt.test.mjs test/execution-authorization.test.mjs test/report.test.mjs",
    "test:smoke": "node --test test/workflow.test.mjs test/documentation.test.mjs test/execution-policy.test.mjs",
    "test:v2": "node --test --test-name-pattern=\"V2|fallback|Fallback|Luna|luna\" test/controlled-bridge.test.mjs test/execution-policy.test.mjs test/execution-receipt.test.mjs test/report.test.mjs",
    "bridge": "node scripts/bridge.mjs",
    "fast-lane": "node scripts/fast-lane.mjs",
    "workflow:check": "node scripts/check-kit.mjs",
    "pilot": "node --test test/pilots.test.mjs",
    "workflow:init": "node scripts/workflow.mjs init",
    "workflow:freeze": "node scripts/workflow.mjs freeze",
    "workflow:route": "node scripts/workflow.mjs route",
    "workflow:verify": "node scripts/workflow.mjs verify",
    "workflow:owner-status": "node scripts/workflow.mjs status"
  },
  "engines": {
    "node": ">=20"
  }
}
